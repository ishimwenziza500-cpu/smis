# Copy to .env for local setup; never commit real credentials.
DATABASE_URL=postgresql://localhost:5432/smis
DATABASE_SSL=false
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Leave unset for the supported same-origin deployment.
CORS_ORIGIN=
